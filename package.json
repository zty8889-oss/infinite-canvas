{
  "name": "infinite-canvas-desktop",
  "version": "1.3.2",
  "private": true,
  "description": "AI storyboarding and node canvas for Windows desktop",
  "author": "zty8889-oss",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "prestart": "node desktop/create-icon.cjs",
    "dist:win": "electron-builder --win nsis --x64",
    "predist:win": "node desktop/create-icon.cjs"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "build": {
    "appId": "com.zty8889.infinitecanvas",
    "productName": "无限画布",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "node.html",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "icon": "desktop/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "无限画布",
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "InfiniteCanvas-${version}-${arch}-Setup.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "zty8889-oss",
        "repo": "infinite-canvas"
      }
    ]
  }
}
